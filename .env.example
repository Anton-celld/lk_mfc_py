# Услуги МФЦ. Скопируйте в .env и заполните (в репозиторий .env не попадает).
# Подпись билета входа из кабинета: ОБЩИЙ секрет, тот же MFC_PORTAL_SSO_SECRET в .env keycloak-auth-service (не короче 32 байт)
MFC_PORTAL_SSO_SECRET=                          # openssl rand -base64 48
# Адрес сервиса в кабинете, обязательно https (на локальном стенде подставляется из docker-compose.override.yml)
MFC_PUBLIC_URL=https://lk.example.ru/mfc/
# HTTP-сервис 1С (см. ONEC_API.md). Пусто: сервис запустится, но данные студента недоступны
# Выбор транспорта к 1С: HTTP-сервис (старый) или SOAP (защищённый WSDL).
# Это НЕ отключает межсервисное взаимодействие по HTTP / API Gateway.
MFC_ONEC_TRANSPORT=http
MFC_ONEC_BASE_URL=
MFC_ONEC_WSDL=
MFC_ONEC_TIMEOUT=20
MFC_ONEC_MAX_CONCURRENT=5
# Если применяется внутренний сертификат, предоставьте доверенный CA-файл.
MFC_ONEC_CA_FILE=
# MFC_ONEC_LOGIN — логин SOAP; MFC_ONEC_USER сохраняется для обратной совместимости.
MFC_ONEC_LOGIN=
MFC_ONEC_USER=
MFC_ONEC_PASSWORD=
# Поиск организаций по ИНН: demo или dadata (тогда нужен MFC_DADATA_TOKEN)
MFC_EGRUL_PROVIDER=demo
MFC_DADATA_TOKEN=
MFC_VERSION=0.1.0
